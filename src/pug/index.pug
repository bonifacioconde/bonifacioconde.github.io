//- Layout only — all wording lives in _content.pug, which differs per
    variant branch. Keeping them apart means a theme change can be copied
    across branches without touching any branch's content.
include _content.pug

doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content=r.meta.description)
        meta(name='author', content=r.name)

        title #{r.name} — #{r.title}

        // Open Graph / social preview
        meta(property='og:type', content='profile')
        meta(property='og:title', content=r.name + ' — ' + r.title)
        meta(property='og:description', content=r.meta.description)
        meta(property='og:image', content='assets/img/profile.jpg')
        meta(name='twitter:card', content='summary')

        link(rel='icon', type='image/x-icon', href='assets/img/favicon.ico')

        // Font Awesome icons (free version, CSS build — renders without JS)
        link(href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css', rel='stylesheet')

        // Core theme CSS (includes Bootstrap)
        link(href='css/styles.css', rel='stylesheet')

    body#page-top

        .container

            // Header — circular photo overlapping the top of the card
            #photo-header.text-center
                #photo
                    img(src='assets/img/profile.jpg', alt=r.name)

            #text-header.text-center
                h1
                    = r.name
                    span= r.title
                .header-meta
                    = r.location + ' · ' + r.availability

            // About
            .box#about
                h2 About
                each para in r.summary
                    p!= para

            // Work Experience
            .box#work
                h2 Work Experience
                each job in r.work
                    .job
                        .details
                            span.where= job.company
                            span.year= job.start + ' — ' + job.end
                            if job.note
                                .note= job.note
                        .job-details
                            .profession= job.position
                            ul.highlights
                                each point in job.highlights
                                    li!= point

                if r.earlier && r.earlier.length
                    h3.subsection Earlier Experience
                    each job in r.earlier
                        .job.job-earlier
                            .details
                                span.where= job.company
                                span.year= job.start + ' — ' + job.end
                            .job-details
                                .profession= job.position
                                p.description!= job.summary

            // Skills
            .box#skills
                h2 Skills
                each group in r.skills
                    .skill-group
                        .item-skills= group.label
                        each item in group.items
                            span.skill= item

            // Education
            .box#education-box
                h2 Education
                ul#education
                    each item in r.education
                        li
                            .year= item.where
                            .description
                                h3= item.school
                                p= item.degree

            // Contact
            .box#contact
                h2 Contact
                .row
                    each item in r.contact
                        .col-sm-6
                            .contact-item
                                span.icon
                                    i(class=item.icon)
                                span.title= item.label
                                .description
                                    if item.href
                                        a(href=item.href, target=item.external ? '_blank' : false, rel=item.external ? 'noopener' : false)= item.value
                                    else
                                        = item.value

        // Bootstrap core JS
        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')

        // Core theme JS
        script(src='js/scripts.js')
